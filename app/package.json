    "start": "node dist/index.js",
    "test": "node --import tsx --test src/modules/reporting/intake-summary.test.ts src/modules/routing/routing.test.ts src/workflow/process-source.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
